$header-height = 3rem
$gutter = 1rem

.scribe
    display flex
    flex-direction column
    box-sizing border-box
    width 100%
    height 100%
    overflow hidden

// The end of the header is left to the app, for the button that closes its
// panel
.scribe-header
    display flex
    flex-shrink 0
    align-items center
    box-sizing border-box
    height $header-height
    padding 0 $header-height 0 $gutter

.scribe-messages
    flex 1 1 auto
    box-sizing border-box
    padding 0 $gutter $gutter
    overflow-y auto

.scribe-footer
    flex-shrink 0
    box-sizing border-box
    padding 0 $gutter $gutter

.scribe-request
    box-sizing border-box
    width fit-content
    max-width 85%
    margin 1rem 0 0 auto
    padding .5rem .75rem
    border-radius 10px
    background-color var(--defaultBackgroundColor)
    white-space pre-wrap
    overflow-wrap anywhere

.scribe-answer
    margin-top 1.5rem
    overflow-wrap anywhere

.scribe-capability
    margin-top .5rem
    padding .75rem
    border 1px solid var(--dividerColor)
    border-radius .75rem
    background-color var(--paperBackgroundColor)

// Nested: a single class loses to the font weight of the Typography of
// cozy-ui
.scribe-capability .scribe-capability-title
    color var(--primaryTextColor)
    font-weight bold

.scribe-capability-list
    margin .25rem 0 0
    padding-left 1.25rem

.scribe-capability-done
    display flex
    align-items center
    margin-top .5rem
    color var(--successColor)

.scribe-suggestions
    display flex
    flex-wrap wrap
    gap .5rem

// The design fills a chip with the hover color, without a border: cozy-ui only
// has outlined and ghost chips. Nested: a single class loses to the border of
// the chip of cozy-ui
.scribe-suggestions .scribe-suggestion
    border 0
    background-color var(--actionColorHover)

.scribe-composer
    box-sizing border-box
    padding .5rem .5rem .5rem 1rem
    border 1px solid var(--dividerColor)
    border-radius 1.5rem
    background-color var(--paperBackgroundColor)

// As high as the send button on one line
.scribe-composer-input
    flex 1 1 auto
    box-sizing border-box
    min-width 0
    padding .25rem 0
    border 0
    outline 0
    background transparent
    color var(--primaryTextColor)
    font inherit
    line-height 1.5
    resize none

    &::placeholder
        color var(--secondaryTextColor)

.scribe-composer-source--off
    opacity .5
    filter grayscale(1)
