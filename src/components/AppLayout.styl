@require 'settings/breakpoints.styl'

$coz-bar-size = 3rem

.assistant-view
    padding 0
    // The visible height (see useVisualViewportHeight), the bar and its
    // border
    height 'calc(var(--visual-viewport-height, 100dvh) - %s - 1px)' % $coz-bar-size
    display flex
    flex-direction column
    flex 1

// The bar of cozy-bar is fixed below 1024px: the view starts under it
+medium-screen()
    .assistant-view
        margin-top $coz-bar-size

.topbar-border
    border-bottom 1px solid var(--dividerColor)
