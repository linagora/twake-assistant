.sidebar-paper
  overflow-x hidden
  background-color var(--defaultBackgroundColor) !important

  &--docked
    position relative !important
    width 236px
    z-index calc(var(--zIndex-modal) + 30) !important
    transition width 225ms cubic-bezier(0.4, 0, 0.6, 1)

  &--rail
    width 80px
    border-right-color transparent !important

  &--mobile
    width 100vw
    // The visible height: the toolbar of a mobile browser hides the bottom
    // of the layout viewport the modal of Material UI fills; the home bar
    // of a phone is left out too
    box-sizing border-box
    height 100dvh
    padding-bottom env(safe-area-inset-bottom)

.sidebar-drawer--mobile
  z-index calc(var(--zIndex-modal) + 30) !important

.sidebar-conversations
  // A flex item shrinks no further than its content unless told so: the
  // list scrolls instead of pushing the card under it out of the sidebar
  min-height 0
  scrollbar-width thin
  scrollbar-color transparent transparent

  &:hover
    scrollbar-color var(--borderMainColor) transparent

.sidebar-new-chat
  padding-right 1.25rem
  padding-left 1.25rem

.sidebar-mobile-toolbar
  background-color var(--paperBackgroundColor)
  z-index calc(var(--zIndex-modal) + 15)

// The hover color as a background: cozy-ui has no utility for it
.coming-soon
  background-color var(--actionColorHover)
