.searchBarDesktop--result
  border-radius 28px 28px 0 0 !important

.suggestionsPlaceholder
    position absolute
    opacity 0.42
    pointer-events none

.search-bar-icon
    opacity 0.42

.search-bar--mobile
  border-radius 24px !important
  height 48px

// As the scrollbar of the sidebar: cozy-ui has no utility for it
.search-results
  scrollbar-width thin
  scrollbar-color transparent transparent

  &:hover
    scrollbar-color var(--borderMainColor) transparent
