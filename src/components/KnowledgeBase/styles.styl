.intentHost
    width 100%
    height 70vh

    // cozy-interapp injects a bare <iframe>: 150px tall and inline, its
    // baseline gap overflows the dialog into a phantom scrollbar
    iframe
        display block
        width 100%
        height 100%
        border none

// Doubled to outweigh the theme's tooltip rule, injected after this
// stylesheet
.folder-tooltip.folder-tooltip
    max-width 258px
    padding 8px 12px
    border-radius 4px
    background-color var(--greyA400)
    color var(--white)
    font-size 12px
    font-weight 500
    line-height 15.8px
    letter-spacing 0.5px
    text-align center

.folder-tooltip-arrow.folder-tooltip-arrow
    color var(--greyA400)

// The chip of the design is filled with the default background, without a
// border: cozy-ui only has outlined chips. Doubled to outweigh the border
// of the chip of cozy-ui
.folder-chip.folder-chip
    border 0
    background-color var(--defaultBackgroundColor)

// The cross of the design: a thin glyph in a 16px box, 6px after the label,
// where cozy-ui draws a 22px icon with its own margins. The padding makes a
// 24px touch target (WCAG 2.5.8), the negative margins keep the glyph and the
// chip where they were. Tripled to outweigh the right margin of the outlined
// chip of cozy-ui, injected after this stylesheet
.folder-chip-remove.folder-chip-remove.folder-chip-remove
    box-sizing content-box
    width 12px
    height 12px
    padding 6px
    margin -6px -1px -6px 0

// The faint tint of the design under the folder, in both themes: the light
// blue utility of cozy-ui stays light on a dark background
.sources-item
    background-color var(--actionColorHover)
