.cozyThread-user-messages
  max-width 80%
  width fit-content
  border-radius 26px
  background var(--defaultBackgroundColor)

.answer
  overflow-wrap anywhere

  // The Markdown of cozy-ui gives a table and a block of code no look and
  // takes no component for them: drawn here, in the colors of the theme
  table
    // The words of the answer break anywhere: in a cell, the table would
    // shrink and break them instead of scrolling
    overflow-wrap break-word
    display block
    width max-content
    max-width 100%
    overflow-x auto
    margin-bottom 1rem
    border-collapse collapse

  th,
  td
    padding .25rem .75rem
    border 1px solid var(--dividerColor)
    text-align left

  th
    background-color var(--defaultBackgroundColor)

  pre
    margin 0 0 1rem
    padding .75rem 1rem
    overflow-x auto
    border-radius 8px
    background-color var(--defaultBackgroundColor)

// The 24px "icon animation" of the design: three 3.8px dots, 6.09px apart,
// each rising 2.855px and growing to 115% over 250ms then falling back,
// 150ms after the previous one, on a 1.2s loop.
.thinking-dots
  display flex
  align-items center
  gap 2.28px
  width 24px
  height 24px
  padding-left 4px
  margin-left 8px
  box-sizing border-box

.thinking-dot
  display block
  width 3.8px
  height 3.8px
  border-radius 50%
  background-color #51ACF0
  animation thinking-bounce 1.2s cubic-bezier(0.33, 0, 0.67, 1) infinite

  &:nth-child(2)
    animation-delay 150ms

  &:nth-child(3)
    animation-delay 300ms

@keyframes thinking-bounce
  0%
    transform none
  20.83%
    transform translateY(-2.855px) scale(1.15)
  41.67%
    transform none
  100%
    transform none

@media (prefers-reduced-motion: reduce)
  .thinking-dot
    animation none
